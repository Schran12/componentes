{
  "name": "componentes-bloomin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run registry:build && vite",
    "build": "npm run registry:build && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "api:key": "node scripts/issue-api-key.mjs",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"scripts/**/*.{js,mjs,ts}\" \"server/**/*.{js,mjs}\" \"api/**/*.{js,mjs}\" \"cli/**/*.{js,mjs,json,md}\" \"*.{md,json,yml,yaml}\" \".github/**/*\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"scripts/**/*.{js,mjs,ts}\" \"server/**/*.{js,mjs}\" \"api/**/*.{js,mjs}\" \"cli/**/*.{js,mjs,json,md}\" \"*.{md,json,yml,yaml}\" \".github/**/*\"",
    "validate": "npm run format:check && npm run lint && npm run build",
    "registry:build": "node scripts/build-registry.mjs",
    "component:add": "node scripts/add-component.mjs"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.8.4",
    "@hookform/resolvers": "^3.3.2",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-toast": "^1.1.5",
    "autoprefixer": "^10.0.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "framer-motion": "^11.18.2",
    "gsap": "^3.12.2",
    "lenis": "^1.3.26",
    "lucide-react": "^0.577.0",
    "postcss": "^8",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.48.2",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.30.6",
    "serve": "^14.2.6",
    "swiper": "^11.0.5",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "typescript": "^5",
    "vite": "^6.4.4"
  }
}
