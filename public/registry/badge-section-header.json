{
  "schemaVersion": 1,
  "registry": "componentes-bloomin",
  "name": "badge-section-header",
  "kind": "component",
  "title": "BadgeSectionHeader",
  "description": "Cabeçalho de seção com selo (badge), título e subtítulo em tema claro ou escuro.",
  "meta": {
    "category": "primitives",
    "role": "section.primitives",
    "placement": "inside-main",
    "stage": null,
    "topics": [],
    "clientComponent": false,
    "importPath": "@/components/library/primitives/BadgeSectionHeader",
    "tags": [
