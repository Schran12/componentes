      "content": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\" />\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n  <title>Radial Cards</title>\r\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\r\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\r\n  <link\r\n    href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap\"\r\n    rel=\"stylesheet\"\r\n  />\r\n  <style>\r\n    /* ============================================================\r\n       CUSTOMISE — tweak colours, typography, and motion tokens\r\n       ============================================================ */\r\n    :root {\r\n      /* Background & ambient glow */\r\n      --bg-deep-olive: #2b302a;\r\n      --glow-soft-white: rgba(255, 255, 255, 0.14);\r\n      --glow-spread: 42vmin;\r\n\r\n      /* Polaroid card surface */\r\n      --card-paper-cream: #f4f1ea;\r\n      --card-frame-padding: 5.5%;\r\n      --card-width-min: 120px;\r\n      --card-width-vw: 18vw;\r\n      --card-width-vh: 34vh;\r\n      --card-width-max: 260px;\r\n      --card-radius-photo: 3px;\r\n      --card-shadow-layer-1: 0 2px 8px rgba(0, 0, 0, 0.12);\r\n      --card-shadow-layer-2: 0 12px 28px rgba(0, 0, 0, 0.22);\r\n      --card-shadow-layer-3: 0 24px 48px rgba(0, 0, 0, 0.18);\r\n\r\n      /* Label typography (Space Mono) */\r\n      --label-tracking: 0.14em;\r\n      --label-size: clamp(9px, 1.35vw, 11px);\r\n      --label-color: #3a3f38;\r\n\r\n      /* Wheel geometry (must match JS constants if changed) */\r\n      --wheel-deg-per-slot: 16deg;\r\n      --wheel-radius-factor: 4.6;\r\n      --wheel-lift-factor: 0.08;\r\n      --wheel-scale-boost: 0.06;\r\n      --parallax-x-percent: 6;\r\n      --hide-angle-deg: 68;\r\n\r\n      /* UI controls */\r\n      --ui-font: \"Space Grotesk\", system-ui, sans-serif;\r\n      --mono-font: \"Space Mono\", ui-monospace, monospace;\r\n      --pill-cream: var(--card-paper-cream);\r\n      --pill-ghost-border: rgba(244, 241, 234, 0.35);\r\n      --pill-text-dark: #2b302a;\r\n\r\n      /* Motion durations (seconds) — JS reads data attributes too */\r\n      --duration-step: 0.95;\r\n      --duration-snap: 1.1;\r\n      --duration-intro: 1.7;\r\n      --autoplay-interval: 2.8;\r\n    }\r\n\r\n    *,\r\n    *::before,\r\n    *::after {\r\n      box-sizing: border-box;\r\n    }\r\n\r\n    html,\r\n    body {\r\n      margin: 0;\r\n      height: 100%;\r\n      overflow: hidden;\r\n      background: var(--bg-deep-olive);\r\n      color: var(--card-paper-cream);\r\n      font-family: var(--ui-font);\r\n      -webkit-font-smoothing: antialiased;\r\n    }\r\n\r\n    .stage {\r\n      position: relative;\r\n      width: 100vw;\r\n      height: 100vh;\r\n      display: flex;\r\n      flex-direction: column;\r\n      align-items: center;\r\n      justify-content: flex-end;\r\n      padding-bottom: clamp(24px, 6vh, 56px);\r\n      touch-action: none;\r\n      user-select: none;\r\n      cursor: grab;\r\n    }\r\n\r\n    .stage.is-dragging {\r\n      cursor: grabbing;\r\n    }\r\n\r\n    .stage__glow {\r\n      pointer-events: none;\r\n      position: absolute;\r\n      left: 50%;\r\n      top: 38%;\r\n      width: min(120vw, 140vh);\r\n      height: min(120vw, 140vh);\r\n      transform: translate(-50%, -50%);\r\n      background: radial-gradient(\r\n        circle at 50% 42%,\r\n        var(--glow-soft-white) 0%,\r\n        transparent var(--glow-spread)\r\n      );\r\n      z-index: 0;\r\n    }\r\n\r\n    .wheel {\r\n      position: absolute;\r\n      left: 50%;\r\n      top: 58%;\r\n      width: 0;\r\n      height: 0;\r\n      z-index: 2;\r\n      will-change: transform;\r\n    }\r\n\r\n    .card {\r\n      position: absolute;\r\n      left: 0;\r\n      top: 0;\r\n      width: clamp(\r\n        var(--card-width-min),\r\n        min(var(--card-width-vw), var(--card-width-vh)),\r\n        var(--card-width-max)\r\n      );\r\n      transform-origin: 50% 50%;\r\n      will-change: transform, opacity;\r\n      pointer-events: none;\r\n    }\r\n\r\n    .card.is-hidden {\r\n      opacity: 0;\r\n      visibility: hidden;\r\n    }\r\n\r\n    .card__polaroid {\r\n      background: var(--card-paper-cream);\r\n      padding: var(--card-frame-padding);\r\n      border-radius: 2px;\r\n      box-shadow:\r\n        var(--card-shadow-layer-1),\r\n        var(--card-shadow-layer-2),\r\n        var(--card-shadow-layer-3);\r\n    }\r\n\r\n    .card__photo-wrap {\r\n      position: relative;\r\n      width: 100%;\r\n      aspect-ratio: 1 / 1.08;\r\n      overflow: hidden;\r\n      border-radius: var(--card-radius-photo);\r\n      background: #d8d4cb;\r\n    }\r\n\r\n    .card__photo {\r\n      position: absolute;\r\n      inset: 0;\r\n      width: 120%;\r\n      height: 100%;\r\n      object-fit: cover;\r\n      left: -10%;\r\n      will-change: transform;\r\n    }\r\n\r\n    .card__label {\r\n      margin: 0.55em 0 0;\r\n      text-align: center;\r\n      font-family: var(--mono-font);\r\n      font-size: var(--label-size);\r\n      font-weight: 700;\r\n      letter-spacing: var(--label-tracking);\r\n      text-transform: uppercase;\r\n      color: var(--label-color);\r\n    }\r\n\r\n    .controls {\r\n      position: relative;\r\n      z-index: 5;\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      gap: clamp(16px, 4vw, 32px);\r\n      width: min(92vw, 520px);\r\n    }\r\n\r\n    .btn {\r\n      font-family: var(--ui-font);\r\n      font-size: clamp(13px, 2.4vw, 15px);\r\n      font-weight: 500;\r\n      letter-spacing: 0.04em;\r\n      border: none;\r\n      cursor: pointer;\r\n      transition: opacity 0.2s ease, transform 0.2s ease;\r\n    }\r\n\r\n    .btn:focus-visible {\r\n      outline: 2px solid var(--pill-cream);\r\n      outline-offset: 3px;\r\n    }\r\n\r\n    .btn--ghost {\r\n      background: transparent;\r\n      color: var(--pill-cream);\r\n      padding: 12px 22px;\r\n      border-radius: 999px;\r\n      border: 1px solid var(--pill-ghost-border);\r\n    }\r\n\r\n    .btn--ghost:hover {\r\n      background: rgba(244, 241, 234, 0.06);\r\n    }\r\n\r\n    .btn--solid {\r\n      background: var(--pill-cream);\r\n      color: var(--pill-text-dark);\r\n      padding: 12px 28px;\r\n      border-radius: 999px;\r\n      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);\r\n    }\r\n\r\n    .btn--solid:hover {\r\n      transform: translateY(-1px);\r\n    }\r\n\r\n    .btn:active {\r\n      transform: translateY(0);\r\n    }\r\n\r\n    .counter {\r\n      font-family: var(--mono-font);\r\n      font-size: clamp(14px, 2.6vw, 16px);\r\n      font-weight: 400;\r\n      letter-spacing: 0.08em;\r\n      color: var(--card-paper-cream);\r\n      min-width: 6.5ch;\r\n      text-align: center;\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      gap: 0.35em;\r\n    }\r\n\r\n    .counter__roll {\r\n      display: inline-block;\r\n      height: 1.2em;\r\n      overflow: hidden;\r\n      line-height: 1.2em;\r\n      vertical-align: bottom;\r\n    }\r\n\r\n    .counter__roll-inner {\r\n      display: flex;\r\n      flex-direction: column;\r\n      will-change: transform;\r\n    }\r\n\r\n    .counter__roll-digit {\r\n      height: 1.2em;\r\n      text-align: center;\r\n    }\r\n\r\n    .counter__sep,\r\n    .counter__total {\r\n      opacity: 0.85;\r\n    }\r\n\r\n    @media (prefers-reduced-motion: reduce) {\r\n      .card,\r\n      .card__photo,\r\n      .wheel,\r\n      .counter__roll-inner {\r\n        transition: none !important;\r\n      }\r\n    }\r\n  </style>\r\n</head>\r\n<body>\r\n  <main class=\"stage\" id=\"stage\" aria-label=\"Radial card carousel\">\r\n    <div class=\"stage__glow\" aria-hidden=\"true\"></div>\r\n    <div class=\"wheel\" id=\"wheel\" aria-live=\"polite\"></div>\r\n\r\n    <nav class=\"controls\" aria-label=\"Carousel controls\">\r\n      <button type=\"button\" class=\"btn btn--ghost\" id=\"btnPrev\" aria-label=\"Previous card\">\r\n        Prev\r\n      </button>\r\n\r\n      <div class=\"counter\" id=\"counter\" aria-atomic=\"true\">\r\n        <span class=\"counter__roll\" id=\"counterRoll\" aria-hidden=\"true\">\r\n          <span class=\"counter__roll-inner\" id=\"counterRollInner\"></span>\r\n        </span>\r\n        <span class=\"counter__sep\">/</span>\r\n        <span class=\"counter__total\">10</span>\r\n      </div>\r\n\r\n      <button type=\"button\" class=\"btn btn--solid\" id=\"btnNext\" aria-label=\"Next card\">\r\n        Next\r\n      </button>\r\n    </nav>\r\n  </main>\r\n\r\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js\"></script>\r\n  <script>\r\n    (function () {\r\n      \"use strict\";\r\n\r\n      /**\r\n       * Radial Cards — invisible wheel carousel\r\n       * GSAP 3.12.5 drives continuous `pos`; layout recomputed every tween frame.\r\n       */\r\n\r\n      var CARD_COUNT = 10;\r\n      var DEG_PER_SLOT = 16;\r\n      var RADIUS_FACTOR = 4.6;\r\n      var LIFT_FACTOR = 0.08;\r\n      var SCALE_BOOST = 0.06;\r\n      var PARALLAX_X = 6;\r\n      var HIDE_ANGLE_DEG = 68;\r\n      var WRAP_SEAM = 4.65;\r\n      var DRAG_CARDS_PER_WIDTH = 1 / 1.1;\r\n      var SNAP_VEL_FACTOR = 260;\r\n      var STEP_DURATION = 0.95;\r\n      var SNAP_DURATION = 1.1;\r\n      var INTRO_DURATION = 1.7;\r\n      var AUTOPLAY_MS = 2800;\r\n\r\n      var CARDS_DATA = [\r\n        {\r\n          label: \"COAST\",\r\n          src: \"https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&q=80&auto=format&fit=crop\",\r\n        },\r\n        {\r\n          label: \"ALPINE\",\r\n          src: \"https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=800&q=80&auto=format&fit=crop\",\r\n        },\r\n        {\r\n          label: \"DUSK\",\r\n          src: \"https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&q=80&auto=format&fit=crop\",\r\n        },\r\n        {\r\n          label: \"DESERT\",\r\n          src: \"https://images.unsplash.com/photo-1509316785289-025f5b846b35?w=800&q=80&auto=format&fit=crop\",\r\n        },\r\n        {\r\n          label: \"FOREST\",\r\n          src: \"https://images.unsplash.com/photo-1448375240586-882707db888b?w=800&q=80&auto=format&fit=crop\",\r\n        },\r\n        {\r\n          label: \"URBAN\",\r\n          src: \"https://images.unsplash.com/photo-1480714378408-67cf0d13bc1b?w=800&q=80&auto=format&fit=crop\",\r\n        },\r\n        {\r\n          label: \"NORDIC\",\r\n          src: \"https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&q=80&auto=format&fit=crop\",\r\n        },\r\n        {\r\n          label: \"REEF\",\r\n          src: \"https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=800&q=80&auto=format&fit=crop\",\r\n        },\r\n        {\r\n          label: \"MIST\",\r\n          src: \"https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=800&q=80&auto=format&fit=crop\",\r\n        },\r\n        {\r\n          label: \"SUMMIT\",\r\n          src: \"https://images.unsplash.com/photo-1519681393784-d120267933ba?w=800&q=80&auto=format&fit=crop\",\r\n        },\r\n      ];\r\n\r\n      var stage = document.getElementById(\"stage\");\r\n      var wheel = document.getElementById(\"wheel\");\r\n      var btnPrev = document.getElementById(\"btnPrev\");\r\n      var btnNext = document.getElementById(\"btnNext\");\r\n      var counterRollInner = document.getElementById(\"counterRollInner\");\r\n\r\n      var state = {\r\n        pos: 0,\r\n        spread: 0.15,\r\n        lift: 1,\r\n        introY: 120,\r\n        cardWidth: 200,\r\n        reducedMotion: false,\r\n        dragging: false,\r\n        autoplayTimer: null,\r\n        hoverPaused: false,\r\n        lastIndex: 0,\r\n      };\r\n\r\n      var cardEls = [];\r\n      var posProxy = { pos: 0 };\r\n      var spreadProxy = { spread: 0.15, introY: 120, lift: 1 };\r\n      var posTween = null;\r\n      var dragStartX = 0;\r\n      var dragStartPos = 0;\r\n      var lastDragX = 0;\r\n      var lastDragTime = 0;\r\n      var velocity = 0;\r\n\r\n      function padCounter(n) {\r\n        return (n < 10 ? \"0\" : \"\") + n;\r\n      }\r\n\r\n      function wrapDistance(index, pos) {\r\n        var d = index - pos;\r\n        var half = CARD_COUNT / 2;\r\n        while (d > half) d -= CARD_COUNT;\r\n        while (d < -half) d += CARD_COUNT;\r\n        return d;\r\n      }\r\n\r\n      function modIndex(n) {\r\n        return ((n % CARD_COUNT) + CARD_COUNT) % CARD_COUNT;\r\n      }\r\n\r\n      function activeIndex() {\r\n        return modIndex(Math.round(state.pos));\r\n      }\r\n\r\n      function measureCardWidth() {\r\n        if (cardEls[0]) {\r\n          state.cardWidth = cardEls[0].offsetWidth || 200;\r\n        }\r\n      }\r\n\r\n      function buildCounterRoll() {\r\n        counterRollInner.innerHTML = \"\";\r\n        for (var i = 1; i <= CARD_COUNT; i++) {\r\n          var span = document.createElement(\"span\");\r\n          span.className = \"counter__roll-digit\";\r\n          span.textContent = padCounter(i);\r\n          counterRollInner.appendChild(span);\r\n        }\r\n        setCounterRollPosition(state.lastIndex, false);\r\n      }\r\n\r\n      function setCounterRollPosition(index, animate) {\r\n        var digitH = 1.2;\r\n        var targetY = -index * digitH;\r\n        if (state.reducedMotion || !animate) {\r\n          gsap.set(counterRollInner, { y: targetY + \"em\" });\r\n          return;\r\n        }\r\n        gsap.to(counterRollInner, {\r\n          y: targetY + \"em\",\r\n          duration: 0.55,\r\n          ease: \"power3.inOut\",\r\n          overwrite: true,\r\n        });\r\n      }\r\n\r\n      function updateCounterDisplay(animate) {\r\n        var idx = activeIndex();\r\n        if (idx !== state.lastIndex) {\r\n          state.lastIndex = idx;\r\n          setCounterRollPosition(idx, animate);\r\n        }\r\n      }\r\n\r\n      function buildCards() {\r\n        wheel.innerHTML = \"\";\r\n        cardEls = [];\r\n        CARDS_DATA.forEach(function (data, i) {\r\n          var card = document.createElement(\"article\");\r\n          card.className = \"card\";\r\n          card.setAttribute(\"data-index\", String(i));\r\n          card.innerHTML =\r\n            '<div class=\"card__polaroid\">' +\r\n            '<div class=\"card__photo-wrap\">' +\r\n            '<img class=\"card__photo\" src=\"' +\r\n            data.src +\r\n            '\" alt=\"\" loading=\"lazy\" draggable=\"false\" />' +\r\n            \"</div>\" +\r\n            '<p class=\"card__label\">' +\r\n            data.label +\r\n            \"</p>\" +\r\n            \"</div>\";\r\n          wheel.appendChild(card);\r\n          cardEls.push({\r\n            root: card,\r\n            photo: card.querySelector(\".card__photo\"),\r\n          });\r\n        });\r\n        measureCardWidth();\r\n      }\r\n\r\n      function renderWheel() {\r\n        measureCardWidth();\r\n        var cw = state.cardWidth;\r\n        var R = cw * RADIUS_FACTOR * state.spread;\r\n        var liftGlobal = state.lift;\r\n        var introOffsetY = state.introY;\r\n\r\n        for (var i = 0; i < CARD_COUNT; i++) {\r\n          var d = wrapDistance(i, state.pos) * state.spread;\r\n          var angleDeg = d * DEG_PER_SLOT;\r\n          var angleRad = (angleDeg * Math.PI) / 180;\r\n          var nearness = Math.max(0, 1 - Math.abs(d));\r\n          var scale = 1 + nearness * SCALE_BOOST;\r\n          var x = Math.sin(angleRad) * R;\r\n          var y =\r\n            (1 - Math.cos(angleRad)) * R -\r\n            nearness * cw * LIFT_FACTOR * liftGlobal +\r\n            introOffsetY;\r\n          var rotation = angleDeg;\r\n\r\n          var hide =\r\n            Math.abs(angleDeg) > HIDE_ANGLE_DEG || Math.abs(d) > WRAP_SEAM;\r\n          var el = cardEls[i];\r\n          el.root.classList.toggle(\"is-hidden\", hide);\r\n          if (hide) continue;\r\n\r\n          gsap.set(el.root, {\r\n            x: x,\r\n            y: y,\r\n            rotation: rotation,\r\n            scale: scale,\r\n            xPercent: -50,\r\n            yPercent: -50,\r\n          });\r\n\r\n          gsap.set(el.photo, {\r\n            xPercent: -d * PARALLAX_X,\r\n          });\r\n        }\r\n\r\n        updateCounterDisplay(false);\r\n      }\r\n\r\n      function attachRenderHook(tween) {\r\n        if (!tween) return;\r\n        tween.eventCallback(\"onUpdate\", renderWheel);\r\n      }\r\n\r\n      function killPosTween() {\r\n        if (posTween) {\r\n          posTween.kill();\r\n          posTween = null;\r\n        }\r\n      }\r\n\r\n      function tweenPosTo(target, duration, ease, onDone) {\r\n        killPosTween();\r\n        posProxy.pos = state.pos;\r\n        posTween = gsap.to(posProxy, {\r\n          pos: target,\r\n          duration: duration,\r\n          ease: ease,\r\n          onUpdate: function () {\r\n            state.pos = posProxy.pos;\r\n            renderWheel();\r\n            updateCounterDisplay(true);\r\n          },\r\n          onComplete: function () {\r\n            state.pos = target;\r\n            renderWheel();\r\n            updateCounterDisplay(true);\r\n            posTween = null;\r\n            if (onDone) onDone();\r\n          },\r\n        });\r\n      }\r\n\r\n      function breatheLift() {\r\n        gsap.to(spreadProxy, {\r\n          lift: 0.4,\r\n          duration: STEP_DURATION * 0.45,\r\n          ease: \"power3.inOut\",\r\n          onUpdate: function () {\r\n            state.lift = spreadProxy.lift;\r\n            renderWheel();\r\n          },\r\n          yoyo: true,\r\n          repeat: 1,\r\n        });\r\n      }\r\n\r\n      function stepNext() {\r\n        var target = state.pos + 1;\r\n        tweenPosTo(target, STEP_DURATION, \"power3.inOut\");\r\n        breatheLift();\r\n        updateCounterDisplay(true);\r\n      }\r\n\r\n      function stepPrev() {\r\n        var target = state.pos - 1;\r\n        tweenPosTo(target, STEP_DURATION, \"power3.inOut\");\r\n        breatheLift();\r\n        updateCounterDisplay(true);\r\n      }\r\n\r\n      function snapAfterDrag() {\r\n        var cw = state.cardWidth || 200;\r\n        var target = Math.round(state.pos - (velocity * SNAP_VEL_FACTOR) / cw);\r\n        tweenPosTo(target, SNAP_DURATION, \"power3.inOut\");\r\n      }\r\n\r\n      function runIntro() {\r\n        spreadProxy.spread = 0.15;\r\n        spreadProxy.introY = 120;\r\n        state.spread = 0.15;\r\n        state.introY = 120;\r\n        renderWheel();\r\n\r\n        if (state.reducedMotion) {\r\n          state.spread = 1;\r\n          state.introY = 0;\r\n          renderWheel();\r\n          return;\r\n        }\r\n\r\n        gsap.to(spreadProxy, {\r\n          spread: 1,\r\n          introY: 0,\r\n          duration: INTRO_DURATION,\r\n          ease: \"expo.inOut\",\r\n          onUpdate: function () {\r\n            state.spread = spreadProxy.spread;\r\n            state.introY = spreadProxy.introY;\r\n            renderWheel();\r\n          },\r\n        });\r\n      }\r\n\r\n      function clearAutoplay() {\r\n        if (state.autoplayTimer) {\r\n          clearInterval(state.autoplayTimer);\r\n          state.autoplayTimer = null;\r\n        }\r\n      }\r\n\r\n      function startAutoplay() {\r\n        clearAutoplay();\r\n        if (state.reducedMotion) return;\r\n        state.autoplayTimer = setInterval(function () {\r\n          if (state.hoverPaused || state.dragging) return;\r\n          stepNext();\r\n        }, AUTOPLAY_MS);\r\n      }\r\n\r\n      function onPointerDown(e) {\r\n        if (state.reducedMotion) return;\r\n        state.dragging = true;\r\n        stage.classList.add(\"is-dragging\");\r\n        killPosTween();\r\n        dragStartX = e.clientX;\r\n        dragStartPos = state.pos;\r\n        lastDragX = e.clientX;\r\n        lastDragTime = performance.now();\r\n        velocity = 0;\r\n        stage.setPointerCapture(e.pointerId);\r\n      }\r\n\r\n      function onPointerMove(e) {\r\n        if (!state.dragging) return;\r\n        var now = performance.now();\r\n        var dt = Math.max(now - lastDragTime, 1);\r\n        var dx = e.clientX - lastDragX;\r\n        velocity = dx / dt;\r\n        lastDragX = e.clientX;\r\n        lastDragTime = now;\r\n\r\n        var cw = state.cardWidth || 200;\r\n        var deltaCards = ((e.clientX - dragStartX) / cw) * DRAG_CARDS_PER_WIDTH;\r\n        state.pos = dragStartPos - deltaCards;\r\n        posProxy.pos = state.pos;\r\n        renderWheel();\r\n        updateCounterDisplay(true);\r\n      }\r\n\r\n      function onPointerUp(e) {\r\n        if (!state.dragging) return;\r\n        state.dragging = false;\r\n        stage.classList.remove(\"is-dragging\");\r\n        try {\r\n          stage.releasePointerCapture(e.pointerId);\r\n        } catch (err) {}\r\n        snapAfterDrag();\r\n      }\r\n\r\n      function bindEvents() {\r\n        btnNext.addEventListener(\"click\", function () {\r\n          stepNext();\r\n        });\r\n        btnPrev.addEventListener(\"click\", function () {\r\n          stepPrev();\r\n        });\r\n\r\n        stage.addEventListener(\"pointerdown\", onPointerDown);\r\n        stage.addEventListener(\"pointermove\", onPointerMove);\r\n        stage.addEventListener(\"pointerup\", onPointerUp);\r\n        stage.addEventListener(\"pointercancel\", onPointerUp);\r\n\r\n        stage.addEventListener(\"mouseenter\", function () {\r\n          state.hoverPaused = true;\r\n        });\r\n        stage.addEventListener(\"mouseleave\", function () {\r\n          state.hoverPaused = false;\r\n        });\r\n\r\n        window.addEventListener(\r\n          \"keydown\",\r\n          function (ev) {\r\n            if (ev.key === \"ArrowRight\") {\r\n              ev.preventDefault();\r\n  