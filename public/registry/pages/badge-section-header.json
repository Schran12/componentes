{"schemaVersion":1,"name":"badge-section-header","title":"BadgeSectionHeader","jsx":"<div className=\"grid gap-4 md:grid-cols-2\">\r\n  <BadgeSectionHeader badge=\"Serviços\" title=\"O que fazemos\" subtitle={lorem} />\r\n  <div className=\"bg-slate-900 p-6\">\r\n    <BadgeSectionHeader badge=\"Clientes\" title=\"Quem confia\" subtitle={lorem} tone=\"dark\" />\r\n  </div>\r\n</div>","declarations":[{"name":"lorem","code":"const lorem =\r\n  'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere erat a ante venenatis dapibus.'"}],"imports":[{"module":"@/components/library/primitives/BadgeSectionHeader","name":"BadgeSectionHeader","imported":"BadgeSectionHeader"}],"dependencies":["clsx@^2.0.0","tailwind-merge@^2.0.0"],"files":[{"path":"src/components/library/primitives/BadgeSectionHeader.tsx","type":"component","target":"src/components/library/primitives/BadgeSectionHeader.tsx","content":"import { cn } from '@/lib/utils'\r\n\r\nexport type BadgeSectionHeaderProps = {\r\n  badge: string\r\n  title: string\r\n  subtitle?: string\r\n  tone?: 'light' | 'dark'\r\n  align?: 'center' | 'left'\r\n  titleAs?: 'h1' | 'h2' | 'h3'\r\n  className?: string\r\n}\r\n\r\n/** Cabeçalho com selo em pílula, linhas de brilho âmbar e título em gradiente metálico. */\r\nexport function BadgeSectionHeader({\r\n  badge,\r\n  title,\r\n  subtitle,\r\n  tone = 'light',\r\n  align = 'center',\r\n  titleAs: Title = 'h2',\r\n  className,\r\n}: BadgeSectionHeaderProps) {\r\n  const dark = tone === 'dark'\r\n  const centered = align === 'center'\r\n\r\n  return (\r\n    <div\r\n      className={cn(\r\n        centered ? 'mx-auto max-w-[540px] text-center' : 'max-w-2xl text-left',\r\n        className,\r\n      )}\r\n    >\r\n      <div className={cn('flex', centered && 'justify-center')}>\r\n        <span\r\n          className={cn(\r\n            'group relative rounded-full border px-6 py-1 text-xs backdrop-blur transition-all duration-300 md:text-sm',\r\n            dark\r\n              ? 'border-white/20 bg-white/10 text-slate-200'\r\n              : 'border-slate-300/80 bg-white/70 text-slate-700',\r\n          )}\r\n        >\r\n          <span\r\n            className=\"absolute inset-x-0 -top-px mx-auto h-0.5 w-1/2 bg-gradient-to-r from-transparent via-amber-500 to-transparent transition-all duration-500 group-hover:w-3/4\"\r\n            aria-hidden\r\n          />\r\n          <span\r\n            className=\"absolute inset-x-0 -bottom-px mx-auto h-0.5 w-1/2 bg-gradient-to-r from-transparent via-amber-500 to-transparent\"\r\n            aria-hidden\r\n          />\r\n          <span className=\"relative font-medium\">{badge}</span>\r\n        </span>\r\n      </div>\r\n\r\n      <Title\r\n        className={cn(\r\n          'mt-5 bg-clip-text text-3xl font-semibold uppercase tracking-wide text-transparent sm:text-4xl md:text-[2.75rem] md:leading-[1.15]',\r\n          dark\r\n            ? 'bg-gradient-to-r from-slate-400 via-white to-slate-400'\r\n            : 'bg-gradient-to-r from-slate-500 via-slate-900 to-slate-500',\r\n        )}\r\n      >\r\n        {title}\r\n      </Title>\r\n\r\n      {subtitle ? (\r\n        <p\r\n          className={cn(\r\n            'mt-4 text-base leading-relaxed md:text-lg',\r\n            dark ? 'text-slate-400' : 'text-slate-500',\r\n            centered && 'mx-auto',\r\n          )}\r\n        >\r\n          {subtitle}\r\n        </p>\r\n      ) : null}\r\n    </div>\r\n  )\r\n}\r\n"},{"path":"src/lib/utils.ts","type":"lib","target":"src/lib/utils.ts","content":"import { type ClassValue, clsx } from 'clsx'\r\nimport { twMerge } from 'tailwind-merge'\r\n\r\nexport function cn(...inputs: ClassValue[]) {\r\n  return twMerge(clsx(inputs))\r\n}\r\n"}]}
