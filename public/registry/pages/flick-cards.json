{"schemaVersion":1,"name":"flick-cards","title":"FlickCards","jsx":"<FlickCards height={480} />","declarations":[],"imports":[{"module":"@/components/library/content/FlickCards","name":"FlickCards","imported":"FlickCards"}],"dependencies":["clsx@^2.0.0","tailwind-merge@^2.0.0"],"files":[{"path":"public/flick-cards/index.html","type":"asset","target":"public/flick-cards/index.html","content":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\" />\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n  <title>Flick Cards</title>\r\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\r\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\r\n  <link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap\" rel=\"stylesheet\" />\r\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js\"></script>\r\n  <style>\r\n    /* ═══════════════════════════════════════════════════════════════════════\r\n       CUSTOMISE — tweak colours and sizes here\r\n       ═══════════════════════════════════════════════════════════════════════ */\r\n    :root {\r\n      /* Stage */\r\n      --stage-bg: #050505;              /* main background */\r\n      --stage-perspective: 1400px;      /* 3D depth of the deck */\r\n\r\n      /* Card geometry */\r\n      --card-aspect: 3 / 4.1;           /* portrait ratio */\r\n      --card-width-min: 150px;\r\n      --card-width-max: 380px;\r\n      --card-width-fluid: min(30vw, 50vh);\r\n      --card-radius: 14px;\r\n\r\n      /* Typography */\r\n      --font-ui: \"Space Grotesk\", system-ui, sans-serif;\r\n      --font-mono: \"Space Mono\", ui-monospace, monospace;\r\n      --name-weight: 500;\r\n      --name-size-ratio: 0.13;          /* ~13% of card width */\r\n      --cta-bg: rgba(12, 12, 12, 0.88);\r\n      --cta-text: #f5f5f5;\r\n      --cta-border: rgba(255, 255, 255, 0.12);\r\n\r\n      /* Ambient glow behind deck */\r\n      --glow-blur: 90px;\r\n      --glow-opacity: 0.16;\r\n\r\n      /* Navigation */\r\n      --nav-size: 48px;\r\n      --nav-bg: rgba(255, 255, 255, 0.06);\r\n      --nav-hover: rgba(255, 255, 255, 0.14);\r\n      --nav-color: rgba(255, 255, 255, 0.85);\r\n\r\n      /* Timing (reference — JS uses same values) */\r\n      --autoplay-ms: 3200;\r\n      --flick-threshold-ratio: 0.22;\r\n      --velocity-threshold: 0.5;\r\n    }\r\n\r\n    *, *::before, *::after {\r\n      box-sizing: border-box;\r\n      margin: 0;\r\n      padding: 0;\r\n    }\r\n\r\n    html, body {\r\n      height: 100%;\r\n      overflow: hidden;\r\n    }\r\n\r\n    body {\r\n      font-family: var(--font-ui);\r\n      background: var(--stage-bg);\r\n      color: #fff;\r\n      -webkit-font-smoothing: antialiased;\r\n    }\r\n\r\n    .stage {\r\n      position: relative;\r\n      width: 100vw;\r\n      height: 100vh;\r\n      min-height: 100dvh;\r\n      background: var(--stage-bg);\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      perspective: var(--stage-perspective);\r\n      perspective-origin: 50% 50%;\r\n      overflow: hidden;\r\n      touch-action: pan-y;\r\n    }\r\n\r\n    .ambient {\r\n      position: absolute;\r\n      inset: -10%;\r\n      pointer-events: none;\r\n      z-index: 0;\r\n      overflow: hidden;\r\n    }\r\n\r\n    .ambient__layer {\r\n      position: absolute;\r\n      inset: 0;\r\n      background-size: cover;\r\n      background-position: center;\r\n      filter: blur(var(--glow-blur));\r\n      opacity: 0;\r\n      transform: scale(1.15);\r\n      will-change: opacity;\r\n    }\r\n\r\n    .ambient__layer.is-active {\r\n      opacity: var(--glow-opacity);\r\n    }\r\n\r\n    .deck {\r\n      position: relative;\r\n      width: clamp(\r\n        var(--card-width-min),\r\n        var(--card-width-fluid),\r\n        var(--card-width-max)\r\n      );\r\n      aspect-ratio: var(--card-aspect);\r\n      transform-style: preserve-3d;\r\n      z-index: 2;\r\n    }\r\n\r\n    .card {\r\n      position: absolute;\r\n      inset: 0;\r\n      border-radius: var(--card-radius);\r\n      overflow: hidden;\r\n      transform-style: preserve-3d;\r\n      transform-origin: 50% 50%;\r\n      backface-visibility: hidden;\r\n      cursor: grab;\r\n      user-select: none;\r\n      -webkit-user-select: none;\r\n      will-change: transform;\r\n    }\r\n\r\n    .card.is-dragging {\r\n      cursor: grabbing;\r\n    }\r\n\r\n    .card:not([data-distance=\"0\"]) {\r\n      cursor: default;\r\n      pointer-events: none;\r\n    }\r\n\r\n    .card__media {\r\n      position: absolute;\r\n      inset: 0;\r\n      background-size: cover;\r\n      background-position: center;\r\n      border-radius: inherit;\r\n    }\r\n\r\n    .card__shade {\r\n      position: absolute;\r\n      inset: 0;\r\n      background: #000;\r\n      border-radius: inherit;\r\n      pointer-events: none;\r\n      opacity: 0;\r\n      transition: opacity 0.15s ease;\r\n    }\r\n\r\n    .card__content {\r\n      position: absolute;\r\n      inset: 0;\r\n      display: flex;\r\n      flex-direction: column;\r\n      align-items: center;\r\n      justify-content: space-between;\r\n      padding: clamp(12px, 4vw, 28px) clamp(10px, 3.5vw, 22px);\r\n      pointer-events: none;\r\n      z-index: 2;\r\n    }\r\n\r\n    .card__name {\r\n      flex: 1;\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      text-align: center;\r\n      font-weight: var(--name-weight);\r\n      line-height: 1.15;\r\n      color: #fff;\r\n      text-shadow: 0 2px 24px rgba(0, 0, 0, 0.55);\r\n      opacity: 0;\r\n      transform: translateY(18px);\r\n      width: 100%;\r\n      padding-top: 8%;\r\n    }\r\n\r\n    .card[data-distance=\"0\"] .card__name {\r\n      opacity: 1;\r\n      transform: translateY(0);\r\n    }\r\n\r\n    .card__cta {\r\n      font-family: var(--font-mono);\r\n      font-size: clamp(10px, 2.8vw, 13px);\r\n      letter-spacing: 0.02em;\r\n      padding: 0.65em 1.15em;\r\n      border-radius: 999px;\r\n      border: 1px solid var(--cta-border);\r\n      background: var(--cta-bg);\r\n      color: var(--cta-text);\r\n      opacity: 0;\r\n      transform: translateY(6px);\r\n      margin-bottom: 4%;\r\n      pointer-events: auto;\r\n      cursor: pointer;\r\n      transition: background 0.2s ease, transform 0.2s ease;\r\n    }\r\n\r\n    .card[data-distance=\"0\"] .card__cta {\r\n      opacity: 1;\r\n      transform: translateY(0);\r\n    }\r\n\r\n    .card__cta:hover {\r\n      background: rgba(28, 28, 28, 0.95);\r\n    }\r\n\r\n    .card:not([data-distance=\"0\"]) .card__content {\r\n      visibility: hidden;\r\n    }\r\n\r\n    .nav {\r\n      position: absolute;\r\n      top: 50%;\r\n      transform: translateY(-50%);\r\n      width: var(--nav-size);\r\n      height: var(--nav-size);\r\n      border-radius: 50%;\r\n      border: 1px solid rgba(255, 255, 255, 0.08);\r\n      background: var(--nav-bg);\r\n      color: var(--nav-color);\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      cursor: pointer;\r\n      z-index: 10;\r\n      transition: background 0.2s ease, transform 0.2s ease;\r\n      backdrop-filter: blur(8px);\r\n    }\r\n\r\n    .nav:hover {\r\n      background: var(--nav-hover);\r\n      transform: translateY(-50%) scale(1.06);\r\n    }\r\n\r\n    .nav:active {\r\n      transform: translateY(-50%) scale(0.96);\r\n    }\r\n\r\n    .nav--prev {\r\n      left: clamp(12px, 3vw, 32px);\r\n    }\r\n\r\n    .nav--next {\r\n      right: clamp(12px, 3vw, 32px);\r\n    }\r\n\r\n    .nav svg {\r\n      width: 22px;\r\n      height: 22px;\r\n      fill: none;\r\n      stroke: currentColor;\r\n      stroke-width: 2;\r\n      stroke-linecap: round;\r\n      stroke-linejoin: round;\r\n    }\r\n\r\n    .sr-only {\r\n      position: absolute;\r\n      width: 1px;\r\n      height: 1px;\r\n      padding: 0;\r\n      margin: -1px;\r\n      overflow: hidden;\r\n      clip: rect(0, 0, 0, 0);\r\n      white-space: nowrap;\r\n      border: 0;\r\n    }\r\n\r\n    @media (max-width: 480px) {\r\n      :root {\r\n        --nav-size: 42px;\r\n      }\r\n    }\r\n\r\n    @media (prefers-reduced-motion: reduce) {\r\n      .card__shade {\r\n        transition: none;\r\n      }\r\n      .card__cta {\r\n        transition: none;\r\n      }\r\n    }\r\n  </style>\r\n</head>\r\n<body>\r\n  <main class=\"stage\" id=\"stage\" aria-label=\"Flick Cards product slider\">\r\n    <div class=\"ambient\" id=\"ambient\" aria-hidden=\"true\">\r\n      <div class=\"ambient__layer is-active\" id=\"glowA\"></div>\r\n      <div class=\"ambient__layer\" id=\"glowB\"></div>\r\n    </div>\r\n\r\n    <div class=\"deck\" id=\"deck\"></div>\r\n\r\n    <button type=\"button\" class=\"nav nav--prev\" id=\"btnPrev\" aria-label=\"Previous product\">\r\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\"/></svg>\r\n    </button>\r\n    <button type=\"button\" class=\"nav nav--next\" id=\"btnNext\" aria-label=\"Next product\">\r\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 6l6 6-6 6\"/></svg>\r\n    </button>\r\n\r\n    <p class=\"sr-only\" id=\"liveRegion\" aria-live=\"polite\"></p>\r\n  </main>\r\n\r\n  <script>\r\n    (function () {\r\n      \"use strict\";\r\n\r\n      const PRODUCTS = [\r\n        {\r\n          name: \"Aurora Jacket\",\r\n          image: \"https://images.unsplash.com/photo-1544022613-e87ca75a784a?w=800&q=80&auto=format&fit=crop\"\r\n        },\r\n        {\r\n          name: \"Nova Sneaker\",\r\n          image: \"https://images.unsplash.com/photo-1549298916-b41d501d3772?w=800&q=80&auto=format&fit=crop\"\r\n        },\r\n        {\r\n          name: \"Orbit Bag\",\r\n          image: \"https://images.unsplash.com/photo-1590874103328-eac38a683ce7?w=800&q=80&auto=format&fit=crop\"\r\n        },\r\n        {\r\n          name: \"Pulse Watch\",\r\n          image: \"https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=800&q=80&auto=format&fit=crop\"\r\n        },\r\n        {\r\n          name: \"Drift Cap\",\r\n          image: \"https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=800&q=80&auto=format&fit=crop\"\r\n        },\r\n        {\r\n          name: \"Flux Tee\",\r\n          image: \"https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=800&q=80&auto=format&fit=crop\"\r\n        }\r\n      ];\r\n\r\n      const COUNT = PRODUCTS.length;\r\n      const Z_SLOT = 150;\r\n      const MAX_VISIBLE = 3;\r\n\r\n      const deckEl = document.getElementById(\"deck\");\r\n      const stageEl = document.getElementById(\"stage\");\r\n      const glowA = document.getElementById(\"glowA\");\r\n      const glowB = document.getElementById(\"glowB\");\r\n      const btnPrev = document.getElementById(\"btnPrev\");\r\n      const btnNext = document.getElementById(\"btnNext\");\r\n      const liveRegion = document.getElementById(\"liveRegion\");\r\n\r\n      const reducedMotion = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\r\n      const autoplayMs = reducedMotion ? 0 : 3200;\r\n\r\n      let frontIndex = 0;\r\n      let cardWidth = 280;\r\n      let cardEls = [];\r\n      let isAnimating = false;\r\n      let autoplayTimer = null;\r\n      let glowToggle = false;\r\n\r\n      /** Signed circular distance from front: positive = behind/right in stack order */\r\n      function wrapDistance(index, front) {\r\n        let d = index - front;\r\n        while (d > COUNT / 2) d -= COUNT;\r\n        while (d < -COUNT / 2) d += COUNT;\r\n        return d;\r\n      }\r\n\r\n      function sign(n) {\r\n        return n === 0 ? 0 : n > 0 ? 1 : -1;\r\n      }\r\n\r\n      function getCardPose(d, w) {\r\n        const ad = Math.abs(d);\r\n        if (ad > MAX_VISIBLE) {\r\n          return { hidden: true };\r\n        }\r\n        const sx = sign(d);\r\n        const x = sx * Math.pow(ad, 0.7) * w * 0.52;\r\n        const z = -ad * Z_SLOT;\r\n        const y = ad * w * 0.015;\r\n        const rotateY = -sx * Math.min(ad, MAX_VISIBLE) * 20;\r\n        const rotateZ = sx * ad * 2.2;\r\n        const scale = 1 - ad * 0.035;\r\n        const zIndex = Math.round(20 - ad * 2);\r\n        const shade = d === 0 ? 0 : Math.min(0.18 + ad * 0.2, 0.8);\r\n        return {\r\n          hidden: false,\r\n          x,\r\n          y,\r\n          z,\r\n          rotateX: 0,\r\n          rotateY,\r\n          rotateZ,\r\n          scale,\r\n          zIndex,\r\n          shade,\r\n          distance: d\r\n        };\r\n      }\r\n\r\n      function applyPoseInstant(el, pose) {\r\n        if (pose.hidden) {\r\n          gsap.set(el, {\r\n            visibility: \"hidden\",\r\n            pointerEvents: \"none\"\r\n          });\r\n          return;\r\n        }\r\n        gsap.set(el, {\r\n          visibility: \"visible\",\r\n          x: pose.x,\r\n          y: pose.y,\r\n          z: pose.z,\r\n          rotateX: pose.rotateX,\r\n          rotateY: pose.rotateY,\r\n          rotateZ: pose.rotateZ,\r\n          scale: pose.scale,\r\n          zIndex: pose.zIndex\r\n        });\r\n        el.dataset.distance = String(pose.distance);\r\n        const shade = el.querySelector(\".card__shade\");\r\n        if (shade) shade.style.opacity = String(pose.shade);\r\n      }\r\n\r\n      function measureCardWidth() {\r\n        const rect = deckEl.getBoundingClientRect();\r\n        cardWidth = rect.width || cardWidth;\r\n        cardEls.forEach(function (el) {\r\n          const idx = Number(el.dataset.index);\r\n          const d = wrapDistance(idx, frontIndex);\r\n          const nameEl = el.querySelector(\".card__name\");\r\n          if (nameEl) {\r\n            nameEl.style.fontSize = cardWidth * 0.13 + \"px\";\r\n          }\r\n        });\r\n      }\r\n\r\n      function layoutAll(instant) {\r\n        measureCardWidth();\r\n        cardEls.forEach(function (el) {\r\n          const idx = Number(el.dataset.index);\r\n          const d = wrapDistance(idx, frontIndex);\r\n          const pose = getCardPose(d, cardWidth);\r\n          if (instant || reducedMotion) {\r\n            applyPoseInstant(el, pose);\r\n          }\r\n        });\r\n      }\r\n\r\n      function setAmbientImage(url, instant) {\r\n        const next = glowToggle ? glowB : glowA;\r\n        const prev = glowToggle ? glowA : glowB;\r\n        next.style.backgroundImage = 'url(\"' + url + '\")';\r\n        if (instant || reducedMotion) {\r\n          next.classList.add(\"is-active\");\r\n          prev.classList.remove(\"is-active\");\r\n          glowToggle = !glowToggle;\r\n          return;\r\n        }\r\n        gsap.set(next, { opacity: 0 });\r\n        next.classList.add(\"is-active\");\r\n        gsap.to(prev, {\r\n          opacity: 0,\r\n          duration: 0.55,\r\n          ease: \"power2.inOut\",\r\n          onComplete: function () {\r\n            prev.classList.remove(\"is-active\");\r\n            gsap.set(prev, { clearProps: \"opacity\" });\r\n          }\r\n        });\r\n        gsap.fromTo(\r\n          next,\r\n          { opacity: 0 },\r\n          { opacity: 0.16, duration: 0.65, ease: \"power2.inOut\" }\r\n        );\r\n        glowToggle = !glowToggle;\r\n      }\r\n\r\n      function announce(name) {\r\n        liveRegion.textContent = \"Now showing \" + name;\r\n      }\r\n\r\n      function buildDeck() {\r\n        PRODUCTS.forEach(function (product, i) {\r\n          const card = document.createElement(\"article\");\r\n          card.className = \"card\";\r\n          card.dataset.index = String(i);\r\n          card.setAttribute(\"role\", \"group\");\r\n          card.setAttribute(\"aria-label\", product.name);\r\n\r\n          const media = document.createElement(\"div\");\r\n          media.className = \"card__media\";\r\n          media.style.backgroundImage = 'url(\"' + product.image + '\")';\r\n\r\n          const shade = document.createElement(\"div\");\r\n          shade.className = \"card__shade\";\r\n\r\n          const content = document.createElement(\"div\");\r\n          content.className = \"card__content\";\r\n\r\n          const name = document.createElement(\"h2\");\r\n          name.className = \"card__name\";\r\n          name.textContent = product.name;\r\n\r\n          const cta = document.createElement(\"button\");\r\n          cta.type = \"button\";\r\n          cta.className = \"card__cta\";\r\n          cta.textContent = \"Get this product\";\r\n\r\n          content.appendChild(name);\r\n          content.appendChild(cta);\r\n          card.appendChild(media);\r\n          card.appendChild(shade);\r\n          card.appendChild(content);\r\n          deckEl.appendChild(card);\r\n          cardEls.push(card);\r\n        });\r\n      }\r\n\r\n      function tweenCardToPose(el, pose, duration, delay, ease) {\r\n        if (pose.hidden) {\r\n          return gsap.to(el, {\r\n            duration: reducedMotion ? 0 : duration,\r\n            delay: reducedMotion ? 0 : delay,\r\n            ease: ease,\r\n            visibility: \"hidden\",\r\n            pointerEvents: \"none\"\r\n          });\r\n        }\r\n        const shade = el.querySelector(\".card__shade\");\r\n        return gsap.to(el, {\r\n          duration: reducedMotion ? 0 : duration,\r\n          delay: reducedMotion ? 0 : delay,\r\n          ease: ease,\r\n          visibility: \"visible\",\r\n          pointerEvents: pose.distance === 0 ? \"auto\" : \"none\",\r\n          x: pose.x,\r\n          y: pose.y,\r\n          z: pose.z,\r\n          rotateX: pose.rotateX,\r\n          rotateY: pose.rotateY,\r\n          rotateZ: pose.rotateZ,\r\n          scale: pose.scale,\r\n          zIndex: pose.zIndex,\r\n          onUpdate: function () {\r\n            el.dataset.distance = String(pose.distance);\r\n          },\r\n          onComplete: function () {\r\n            el.dataset.distance = String(pose.distance);\r\n            if (shade) shade.style.opacity = String(pose.shade);\r\n          }\r\n        });\r\n      }\r\n\r\n      function animateFrontContent(in) {\r\n        const front = cardEls[frontIndex];\r\n        if (!front) return;\r\n        const nameEl = front.querySelector(\".card__name\");\r\n        const ctaEl = front.querySelector(\".card__cta\");\r\n        if (reducedMotion) {\r\n          gsap.set(nameEl, { opacity: 1, y: 0 });\r\n          gsap.set(ctaEl, { opacity: 1, y: 0 });\r\n          return;\r\n        }\r\n        if (in) {\r\n          gsap.fromTo(\r\n            nameEl,\r\n            { opacity: 0, y: 18 },\r\n            { opacity: 1, y: 0, duration: 0.55, ease: \"power2.out\", delay: 0.12 }\r\n          );\r\n          gsap.fromTo(\r\n            ctaEl,\r\n            { opacity: 0, y: 10 },\r\n            { opacity: 1, y: 0, duration: 0.45, ease: \"power2.out\", delay: 0.38 }\r\n          );\r\n        } else {\r\n          gsap.set(nameEl, { opacity: 0, y: 18 });\r\n          gsap.set(ctaEl, { opacity: 0, y: 6 });\r\n        }\r\n      }\r\n\r\n      function flick(direction) {\r\n        if (isAnimating) return;\r\n        isAnimating = true;\r\n        stopAutoplay();\r\n\r\n        const nextFront =\r\n          direction === 1\r\n            ? (frontIndex + 1) % COUNT\r\n            : (frontIndex - 1 + COUNT) % COUNT;\r\n\r\n        const outgoing = frontIndex;\r\n        const outgoingEl = cardEls[outgoing];\r\n        const w = cardWidth;\r\n\r\n        measureCardWidth();\r\n\r\n        cardEls.forEach(function (el) {\r\n          if (Number(el.dataset.index) !== outgoing) {\r\n            const idx = Number(el.dataset.index);\r\n            const d = wrapDistance(idx, frontIndex);\r\n            if (d === 0) return;\r\n            const nameEl = el.querySelector(\".card__name\");\r\n            const ctaEl = el.querySelector(\".card__cta\");\r\n            gsap.set(nameEl, { opacity: 0, y: 18 });\r\n            gsap.set(ctaEl, { opacity: 0, y: 6 });\r\n          }\r\n        });\r\n\r\n        const oldFrontName = outgoingEl.querySelector(\".card__name\");\r\n        const oldFrontCta = outgoingEl.querySelector(\".card__cta\");\r\n        gsap.to([oldFrontName, oldFrontCta], {\r\n          opacity: 0,\r\n          duration: reducedMotion ? 0 : 0.2,\r\n          ease: \"power2.in\"\r\n        });\r\n\r\n        if (reducedMotion) {\r\n          frontIndex = nextFront;\r\n          cardEls.forEach(function (el) {\r\n            const idx = Number(el.dataset.index);\r\n            applyPoseInstant(el, getCardPose(wrapDistance(idx, frontIndex), cardWidth));\r\n          });\r\n          setAmbientImage(PRODUCTS[frontIndex].image, true);\r\n          animateFrontContent(true);\r\n          announce(PRODUCTS[frontIndex].name);\r\n          isAnimating = false;\r\n          startAutoplay();\r\n          return;\r\n        }\r\n\r\n        const targetX = direction === 1 ? -w * 1.05 : w * 1.05;\r\n\r\n        const tl = gsap.timeline({\r\n          onComplete: function () {\r\n            frontIndex = nextFront;\r\n            cardEls.forEach(function (el) {\r\n              const idx = Number(el.dataset.index);\r\n              applyPoseInstant(el, getCardPose(wrapDistance(idx, frontIndex), cardWidth));\r\n            });\r\n            setAmbientImage(PRODUCTS[frontIndex].image, false);\r\n            animateFrontContent(true);\r\n            announce(PRODUCTS[frontIndex].name);\r\n            isAnimating = false;\r\n            startAutoplay();\r\n          }\r\n        });\r\n\r\n        tl.to(outgoingEl, {\r\n          x: targetX,\r\n          y: -w * 0.06,\r\n          rotateZ: direction === 1 ? -14 : 14,\r\n          rotateY: direction === 1 ? 30 : -30,\r\n          scale: 0.96,\r\n          duration: 0.4,\r\n          ease: \"power3.out\"\r\n        }, 0);\r\n\r\n        tl.add(function () {\r\n          const newD = wrapDistance(outgoing, nextFront);\r\n          const slotPose = getCardPose(newD, w);\r\n          gsap.set(outgoingEl, { zIndex: slotPose.hidden ? 1 : slotPose.zIndex });\r\n          if (slotPose.hidden) {\r\n            gsap.set(outgoingEl, { visibility: \"hidden\", pointerEvents: \"none\" });\r\n            return;\r\n          }\r\n          gsap.to(outgoingEl, {\r\n            x: slotPose.x,\r\n            y: slotPose.y,\r\n            z: slotPose.z,\r\n            rotateX: 0,\r\n            rotateY: slotPose.rotateY,\r\n            rotateZ: slotPose.rotateZ,\r\n            scale: slotPose.scale,\r\n            duration: 0.66,\r\n            ease: \"expo.out\",\r\n            onUpdate: function () {\r\n              outgoingEl.dataset.distance = String(newD);\r\n            },\r\n            onComplete: function () {\r\n              outgoingEl.dataset.distance = String(newD);\r\n              const sh = outgoingEl.querySelector(\".card__shade\");\r\n              if (sh) sh.style.opacity = String(slotPose.shade);\r\n            }\r\n          });\r\n        }, 0.4);\r\n\r\n        cardEls.forEach(function (el) {\r\n          const idx = Number(el.dataset.index);\r\n          if (idx === outgoing) return;\r\n          const newD = wrapDistance(idx, nextFront);\r\n          const pose = getCardPose(newD, w);\r\n          const oldD = wrapDistance(idx, frontIndex);\r\n          const steps = Math.abs(newD - oldD);\r\n          const staggerAt = 0.4 + steps * 0.03;\r\n          tweenCardToPose(el, pose, 0.95, staggerAt, \"expo.out\");\r\n        });\r\n      }\r\n\r\n      function runIntro() {\r\n        measureCardWidth();\r\n        cardEls.forEach(function (el, i) {\r\n          const idx = Number(el.dataset.index);\r\n          const d = wrapDistance(idx, frontIndex);\r\n          const pose = getCardPose(d, cardWidth);\r\n          const tilt = (i % 2 === 0 ? 1 : -1) * 24;\r\n          if (reducedMotion) {\r\n            applyPoseInstant(el, pose);\r\n            return;\r\n          }\r\n          gsap.set(el, {\r\n            y: cardWidth * 1.4,\r\n            rotateZ: tilt,\r\n            rotateY: 0,\r\n            x: 0,\r\n            z: -400,\r\n            scale: 0.85,\r\n            visibility: \"visible\"\r\n          });\r\n          const delay = Math.max(0, MAX_VISIBLE - Math.min(Math.abs(d), MAX_VISIBLE)) * 0.07;\r\n          gsap.to(el, {\r\n            x: pose.x,\r\n            y: pose.y,\r\n            z: pose.z,\r\n            rotateY: pose.rotateY,\r\n            rotateZ: pose.rotateZ,\r\n            scale: pose.scale,\r\n            duration: 1.4,\r\n            delay: delay,\r\n            ease: \"expo.out\",\r\n            onComplete: function () {\r\n              el.dataset.distance = String(d);\r\n              const sh = el.querySelector(\".card__shade\");\r\n              if (sh) sh.style.opacity = String(pose.shade);\r\n              gsap.set(el, { zIndex: pose.zIndex });\r\n            }\r\n          });\r\n        });\r\n\r\n        if (!reducedMotion) {\r\n          gsap.delayedCall(1.4 + MAX_VISIBLE * 0.07 + 0.1, function () {\r\n            animateFrontContent(true);\r\n          });\r\n        } else {\r\n          animateFrontContent(true);\r\n        }\r\n      }\r\n\r\n      /* ─── Drag interaction on front card ─── */\r\n      let dragStartX = 0;\r\n      let dragLastX = 0;\r\n      let dragLastT = 0;\r\n      let dragVelocity = 0;\r\n      let dragActive = false;\r\n      let dragEl = null;\r\n\r\n      function getFrontEl() {\r\n        return cardEls[frontIndex];\r\n      }\r\n\r\n      function onPointerDown(e) {\r\n        if (isAnimating || reducedMotion) return;\r\n        const el = getFrontEl();\r\n        if (!el || e.target.closest(\".card__cta\")) return;\r\n        if (wrapDistance(Number(el.dataset.index), frontIndex) !== 0) return;\r\n\r\n        dragActive = true;\r\n        dragEl = el;\r\n        dragStartX = e.clientX;\r\n        dragLastX = e.clientX;\r\n        dragLastT = performance.now();\r\n        dragVelocity = 0;\r\n        el.classList.add(\"is-dragging\");\r\n        el.setPointerCapture(e.pointerId);\r\n        stopAutoplay();\r\n      }\r\n\r\n      function onPointerMove(e) {\r\n        if (!dragActive || !dragEl) return;\r\n        const now = performance.now();\r\n        const dx = e.clientX - dragStartX;\r\n        const dt = Math.max(now - dragLastT, 1);\r\n        dragVelocity = (e.clientX - dragLastX) / dt;\r\n        dragLastX = e.clientX;\r\n        dragLastT = now;\r\n\r\n        const rotY = dx * 0.04;\r\n        const rotZ = dx * 0.015;\r\n        gsap.set(dragEl, {\r\n          x: dx,\r\n          rotateY: rotY,\r\n          rotateZ: rotZ\r\n        });\r\n      }\r\n\r\n      function onPointerUp(e) {\r\n        if (!dragActive || !dragEl) return;\r\n        const el = dragEl;\r\n        dragActive = false;\r\n        dragEl = null;\r\n        el.classList.remove(\"is-dragging\");\r\n        try {\r\n          el.releasePointerCapture(e.pointerId);\r\n        } catch (_) {}\r\n\r\n        const dx = e.clientX - dragStartX;\r\n        const threshold = cardWidth * 0.22;\r\n        const fast = Math.abs(dragVelocity) > 0.5;\r\n\r\n        if (dx < -threshold || (fast && dragVelocity < 0)) {\r\n          flick(1);\r\n          return;\r\n        }\r\n        if (dx > threshold || (fast && dragVelocity > 0)) {\r\n          flick(-1);\r\n          return;\r\n        }\r\n\r\n        const pose = getCardPose(0, cardWidth);\r\n        gsap.to(el, {\r\n          x: pose.x,\r\n          y: pose.y,\r\n          rotateY: pose.rotateY,\r\n          rotateZ: pose.rotateZ,\r\n          duration: 0.55,\r\n          ease: \"elastic.out(1, 0.6)\"\r\n        });\r\n        startAutoplay();\r\n      }\r\n\r\n      function startAutoplay() {\r\n        if (reducedMotion || autoplayMs <= 0) return;\r\n        stopAutoplay();\r\n        autoplayTimer = window.setInterval(function () {\r\n          if (!stageEl.matches(\":hover\") && !dragActive && !isAnimating) {\r\n            flick(1);\r\n          }\r\n        }, autoplayMs);\r\n      }\r\n\r\n      function stopAutoplay() {\r\n        if (autoplayTimer) {\r\n          clearInterval(autoplayTimer);\r\n          autoplayTimer = null;\r\n        }\r\n      }\r\n\r\n      function init() {\r\n        buildDeck();\r\n        gsap.set(deckEl, { transformStyle: \"preserve-3d\" });\r\n        cardEls.forEach(function (el) {\r\n          gsap.set(el, { transformOrigin: \"50% 50%\", force3D: true });\r\n        });\r\n\r\n        layoutAll(true);\r\n        setAmbientImage(PRODUCTS[0].image, true);\r\n        announce(PRODUCTS[0].name);\r\n\r\n        runIntro();\r\n        startAutoplay();\r\n\r\n        deckEl.addEventListener(\"pointerdown\", onPointerDown);\r\n        window.addEventListener(\"pointermove\", onPointerMove);\r\n        window.addEventListener(\"pointerup\", onPointerUp);\r\n        window.addEventListener(\"pointercancel\", onPointerUp);\r\n\r\n        btnNext.addEventListener(\"click\", function () {\r\n          flick(1);\r\n        });\r\n        btnPrev.addEventListener(\"click\", function () {\r\n          flick(-1);\r\n        });\r\n\r\n        window.addEventListener(\"keydown\", function (e) {\r\n          if (e.key === \"ArrowRight\") flick(1);\r\n          if (e.key === \"ArrowLeft\") flick(-1);\r\n        });\r\n\r\n        window.addEventListener(\"resize\", function () {\r\n          if (!isAnimating) {\r\n            layoutAll(true);\r\n          }\r\n        });\r\n\r\n        stageEl.addEventListener(\"mouseenter\", stopAutoplay);\r\n        stageEl.addEventListener(\"mouseleave\", startAutoplay);\r\n      }\r\n\r\n      if (document.readyState === \"loading\") {\r\n        document.addEventListener(\"DOMContentLoaded\", init);\r\n      } else {\r\n        init();\r\n      }\r\n    })();\r\n  </script>\r\n</body>\r\n</html>\r\n"},{"path":"src/components/library/content/FlickCards.tsx","type":"component","target":"src/components/library/content/FlickCards.tsx","content":"'use client'\r\n\r\nimport { demoUrl } from '@/lib/demoOrigin'\r\nimport { cn } from '@/lib/utils'\r\n\r\nexport type FlickCardsProps = {\r\n  /** URL do demo estático. Padrão: CDN do catálogo / local em localhost. */\r\n  src?: string\r\n  height?: number | string\r\n  title?: string\r\n  className?: string\r\n}\r\n\r\n/**\r\n * Flick Cards — deck 3D em leque (GSAP): arraste/flick, setas, autoplay e glow ambient.\r\n * Demo autocontida em public/flick-cards/index.html.\r\n */\r\nexport function FlickCards({\r\n  src,\r\n  height = 560,\r\n  title = 'Flick Cards',\r\n  className,\r\n}: FlickCardsProps) {\r\n  const demoSrc = src ?? demoUrl('/flick-cards/index.html')\r\n  return (\r\n    <div\r\n      className={cn(\r\n        'relative w-full overflow-hidden rounded-2xl border border-white/10 bg-[#050505]',\r\n        className,\r\n      )}\r\n      style={{ height }}\r\n    >\r\n      <iframe\r\n        title={title}\r\n        src={demoSrc}\r\n        className=\"absolute inset-0 h-full w-full border-0\"\r\n        loading=\"lazy\"\r\n        allow=\"autoplay\"\r\n      />\r\n    </div>\r\n  )\r\n}\r\n"},{"path":"src/lib/demoOrigin.ts","type":"lib","target":"src/lib/demoOrigin.ts","content":"/** Origem dos demos estáticos (HTML/CSS/JS) publicados no catálogo. */\r\nexport const DEMO_ORIGIN = 'https://componentes-indol.vercel.app'\r\n\r\n/**\r\n * Resolve URL de demo embutido (iframe / assets).\r\n * - No catálogo local (localhost), usa caminho relativo para hot-reload dos demos.\r\n * - Em projetos consumidores (API/mirror), aponta ao CDN do catálogo para\r\n *   garantir estilização e efeitos mesmo antes de copiar `public/`.\r\n */\r\nexport function demoUrl(path: string) {\r\n  const clean = path.startsWith('/') ? path : `/${path}`\r\n  if (typeof window !== 'undefined') {\r\n    const host = window.location.hostname\r\n    if (host === 'localhost' || host === '127.0.0.1') {\r\n      return clean\r\n    }\r\n  }\r\n  return `${DEMO_ORIGIN}${clean}`\r\n}\r\n"},{"path":"src/lib/utils.ts","type":"lib","target":"src/lib/utils.ts","content":"import { type ClassValue, clsx } from 'clsx'\r\nimport { twMerge } from 'tailwind-merge'\r\n\r\nexport function cn(...inputs: ClassValue[]) {\r\n  return twMerge(clsx(inputs))\r\n}\r\n"}]}
