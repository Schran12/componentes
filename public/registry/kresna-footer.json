      "content": "'use client'\r\n\r\nimport { demoUrl } from '@/lib/demoOrigin'\r\nimport { cn } from '@/lib/utils'\r\n\r\nexport type KresnaFooterProps = {\r\n  /** URL do demo estático. */\r\n  src?: string\r\n  height?: number | string\r\n  title?: string\r\n  className?: string\r\n}\r\n\r\n/**\r\n * Kresna Footer — card de vídeo + card claro com nav, badge “Feeling lucky?” e subscribe.\r\n * Demo autocontida em public/kresna-footer/index.html.\r\n */\r\nexport function KresnaFooter({\r\n  src,\r\n  height = 640,\r\n  title = 'Kresna Footer',\r\n  className,\r\n}: KresnaFooterProps) {\r\n  const demoSrc = src ?? demoUrl('/kresna-footer/index.html')\r\n  return (\r\n    <div\r\n      className={cn('relative w-full overflow-hidden rounded-2xl border bg-white', className)}\r\n      style={{ height }}\r\n    >\r\n      <iframe\r\n        title={title}\r\n        src={demoSrc}\r\n        className=\"absolute inset-0 h-full w-full border-0\"\r\n        loading=\"lazy\"\r\n        allow=\"autoplay\"\r\n      />\r\n    </div>\r\n  )\r\n}\r\n"
    },
    {
      "path": "src/lib/demoOrigin.ts",
      "type": "lib",
      "target": "src/lib/demoOrigin.ts",
      "content": "/** Origem dos demos estáticos (HTML/CSS/JS) publicados no catálogo. */\r\nexport const DEMO_ORIGIN = 'https://componentes-indol.vercel.app'\r\n\r\n/**\r\n * Resolve URL de demo embutido (iframe / assets).\r\n * - No catálogo local (localhost), usa caminho relativo para hot-reload dos demos.\r\n * - Em projetos consumidores (API/mirror), aponta ao CDN do catálogo para\r\n *   garantir estilização e efeitos mesmo antes de copiar `public/`.\r\n */\r\nexport function demoUrl(path: string) {\r\n  const clean = path.startsWith('/') ? path : `/${path}`\r\n  if (typeof window !== 'undefined') {\r\n    const host = window.location.hostname\r\n    if (host === 'localhost' || host === '127.0.0.1') {\r\n      return clean\r\n    }\r\n  }\r\n  return `${DEMO_ORIGIN}${clean}`\r\n}\r\n"
    },
    {
      "path": "src/lib/utils.ts",
      "type": "lib",
      "target": "src/lib/utils.ts",
      "content": "import { type ClassValue, clsx } from 'clsx'\r\nimport { twMerge } from 'tailwind-merge'\r\n\r\nexport function cn(...inputs: ClassValue[]) {\r\n  return twMerge(clsx(inputs))\r\n}\r\n"
    }
